# ─────────────────────────────────────────────────────────────
# SPARTA Content Lab — 환경변수 템플릿
#
# 이 파일을 .env로 복사한 뒤 실제 값을 채웁니다.
#   cp .env.example .env
# .env 는 git에 커밋되지 않습니다(.gitignore 처리).
# 이 템플릿(.env.example)만 커밋되어 팀 공유 기준이 됩니다.
# ─────────────────────────────────────────────────────────────

# ── YouTube Data API ─────────────────────────────────────────
# Google Cloud Console에서 발급(무료). 발급 전까지 비워두고 MODE=stub 사용.
YOUTUBE_API_KEY=

# 수집 모드 — 앞서 논의한 "스텁 개발 → 키 전환"의 스위치
#   stub = 녹화된 응답(fixture)으로 개발. 키 없이 동작.
#   live = 실제 YouTube API 호출. 키 준비 후 전환.
YOUTUBE_API_MODE=stub

# ── Gemini 임베딩 API (자사 유사영상·주제 묶기) ────────────────
# YouTube와 같은 Google 계정, 다른 키. 유료(지출 상한은 Google Cloud에서 설정).
GEMINI_API_KEY=

# 임베딩 모드
#   stub = 가짜 벡터로 유사도 로직 개발. 키 없이 동작.
#   live = 실제 gemini-embedding-001 호출. 키 준비 후 전환.
EMBEDDING_MODE=stub

# 임베딩 모델명
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ── 앱 설정 ──────────────────────────────────────────────────
# 스냅샷 날짜 경계 타임존 (아키텍처 확정값 — 일본 대상·수집 시각 기준)
APP_TIME_ZONE=Asia/Tokyo

# 수집 대상 채널 수 상한 (쿼터 보호 안전장치). 비우면 무제한.
# MAX_TRACKED_CHANNELS=100

# ── 참고 ─────────────────────────────────────────────────────
# Rails master key(config/master.key)는 credentials로 관리되며
# 여기 넣지 않습니다. .env는 dotenv-rails 젬으로 로드합니다.
