<%# 대시보드 홈 — 기간 탭·필터·추천 3개 카드 + 시계열 위젯 콜드스타트 자리(6.3~6.6 실 콘텐츠). 읽기 전용(AD-3). %>
<% content_for :title, "대시보드" %>

<%# 필터 행 — 기간 탭(좌) + 카테고리/유형/레이아웃(우), 모바일 세로 스택. %>
<div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
  <%= render "dashboard/period_tabs", current: @period %>
  <%= render "dashboard/filter_bar", category: @category, type: @type, layout: @layout %>
</div>

<%# 추천 섹션 헤더. %>
<section class="mt-8">
  <div class="flex flex-wrap items-baseline gap-2">
    <h2 class="flex items-center gap-2 text-h2 text-ink-strong">
      <span class="text-primary-600" aria-hidden="true">★</span>
      이번 주 추천 콘텐츠 <span class="tabular-nums"><%= @max_recommendations %></span>개
    </h2>
    <p class="text-caption text-ink-muted">데이터 기반으로 선정한 이번 주 제작 우선순위입니다.</p>
    <%# 헤더 확보 칩은 1..target-1 일 때만 — 0개는 아래 empty 카드가 안내하므로 중복 표시하지 않는다. %>
    <% if @recommendations.any? && (note = recommendation_shortfall_note(@recommendations.size, @max_recommendations)) %>
      <span class="inline-flex items-center rounded-chip bg-badge-neutralBg px-1.5 py-0.5 text-label text-badge-neutralFg"><%= note %></span>
    <% end %>
  </div>

  <% if @recommendations.any? %>
    <div class="mt-4 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      <% @recommendations.each_with_index do |recommendation, i| %>
        <%= render "dashboard/recommendation_card", recommendation: recommendation, rank: i + 1, videos_by_rec: @videos_by_rec %>
      <% end %>
    </div>
  <% else %>
    <%# empty 상태 — 자격 미달이면 억지로 채우지 않고 확보 개수 + 수집 중 안내(AD-16). %>
    <div class="mt-4 rounded-card border border-border bg-surface p-6 shadow-card">
      <p class="text-body text-ink-body">이번 주 0개 확보 — 추천할 주제가 아직 없습니다.</p>
      <div class="mt-3">
        <%= render "shared/honesty_status", status: :collecting, detail: "추천 데이터 수집 중" %>
      </div>
    </div>
  <% end %>
</section>

<%# 하단 시계열 위젯 — 실 콘텐츠는 6.3~6.6. 여기선 위젯별 콜드스타트 자리(AD-7, 전역 배너 금지). %>
<section class="mt-8 grid gap-5 lg:grid-cols-3">
  <%# 급상승 영상 — flex 세로: 리스트가 남는 높이를 채우고(옆 박스에 맞춰 유동), 전체보기·안내는 박스 하단 고정. %>
  <div class="flex flex-col rounded-card border border-border bg-surface p-6 shadow-card lg:col-span-2">
    <h3 class="text-h3 text-ink-strong">급상승 영상</h3>
    <% if @top_scores.any? %>
      <div class="mt-4 flex-1 divide-y divide-border-subtle">
        <%= render partial: "dashboard/top_score_item", collection: @top_scores, as: :score %>
      </div>
      <%# mt-auto — 리스트가 짧아도 footer 를 박스 맨 아래로 민다. %>
      <div class="mt-auto border-t border-border-subtle pt-3">
        <%= link_to "전체 보기 →", popular_path(period: "3m"), class: "inline-block text-caption text-primary-600 hover:underline" %>
        <%= render "dashboard/thin_note" if widget_collecting?(:sparkline) %>
      </div>
    <% else %>
      <div class="mt-4 flex-1"><%= render "shared/honesty_status", status: :collecting, detail: widget_collecting_detail(:sparkline) %></div>
    <% end %>
  </div>

  <%# 경쟁 채널 동향 + 콘텐츠 기회 도넛. %>
  <div class="flex flex-col gap-5">
    <div class="rounded-card border border-border bg-surface p-6 shadow-card">
      <h3 class="text-h3 text-ink-strong">경쟁 채널 동향</h3>
      <% if @top_competitors.any? %>
        <div class="mt-4 divide-y divide-border-subtle">
          <%= render partial: "dashboard/competitor_item", collection: @top_competitors, as: :channel %>
        </div>
        <%= link_to "전체 보기 →", competitors_path, class: "mt-3 inline-block text-caption text-primary-600 hover:underline" %>
        <%= render "dashboard/thin_note" if widget_collecting?(:subscriber_delta) %>
      <% else %>
        <div class="mt-4"><%= render "shared/honesty_status", status: :collecting, detail: widget_collecting_detail(:subscriber_delta) %></div>
      <% end %>
    </div>

    <div class="rounded-card border border-border bg-surface p-6 shadow-card">
      <h3 class="text-h3 text-ink-strong">콘텐츠 기회</h3>
      <% if @distribution.values.sum > 0 %>
        <div class="mt-4 flex justify-center"><%= render "content_gap/donut" %></div>
        <%= link_to "전체 보기 →", content_gap_path, class: "mt-3 inline-block text-caption text-primary-600 hover:underline" %>
        <%= render "dashboard/thin_note" if widget_collecting?(:sparkline) %>
      <% else %>
        <div class="mt-4"><%= render "shared/honesty_status", status: :collecting, detail: "데이터 수집 중" %></div>
      <% end %>
    </div>
  </div>
</section>

<%# 에버그린 콘텐츠(6.6) — 후보는 1일차 표시, 검증 에버그린은 스냅샷 축적 후. %>
<section class="mt-8">
  <div class="rounded-card border border-border bg-surface p-6 shadow-card">
    <h3 class="text-h3 text-ink-strong">에버그린 콘텐츠</h3>
    <p class="mt-1 text-caption text-ink-muted">꾸준히 조회수가 유지되는 검증된 주제입니다.</p>
    <div class="mt-4">
      <% if @evergreen_scores.any? %>
        <div class="divide-y divide-border-subtle">
          <%= render partial: "dashboard/evergreen_item", collection: @evergreen_scores, as: :score %>
        </div>
        <%# 대시보드는 상위 요약(최대 5) — 전체는 인기 콘텐츠 에버그린 탭에서(무언의 절단 방지). %>
        <%= link_to "전체 보기 →", popular_path(period: "evergreen"),
              class: "mt-3 inline-block text-caption text-primary-600 hover:underline" %>
      <% elsif widget_collecting?(:evergreen_validation) %>
        <%= render "shared/honesty_status", status: :collecting, detail: widget_collecting_detail(:evergreen_validation) %>
      <% else %>
        <%# 스냅샷은 충분하나 자격 후보가 아직 없음 — 위젯 숨기지 않고 자리 유지(§4.7·AD-16). %>
        <p class="text-caption text-ink-muted">에버그린 후보가 아직 없습니다.</p>
      <% end %>
    </div>
  </div>
</section>

<%# NOTE: error 상태 — 컨트롤러가 던지면 Rails 기본 500/사용자 정의 에러 페이지가 처리. 위젯 단위 부분 실패는 각 위젯이
    자체 collecting/empty 자리로 흡수한다(전역 실패 배너 없음). loading은 위 animate-pulse 스켈레톤 자리로 표현. %>
