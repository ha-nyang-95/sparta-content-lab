<%# 카테고리·유형 드롭다운(라벨 명시). 쿼리 파라미터 링크로 서버 렌더. 로컬: category, type, base_path(옵션 기본 root_path). %>
<% base = local_assigns.fetch(:base_path, root_path) %>
<div class="flex flex-wrap items-center gap-2">
  <% [[:category, "카테고리", category_options, category], [:type, "유형", type_options, type]].each do |param, dim_label, options, current| %>
    <% current_label = options.find { |k, _| k == current }&.last %>
    <%# data-controller=dropdown — 바깥 클릭·다른 드롭다운 열 때 자동 닫힘. %>
    <details class="group relative" data-controller="dropdown">
      <summary class="flex cursor-pointer list-none items-center gap-1.5 rounded-control border border-border bg-surface px-3 py-1.5 text-body text-ink-body">
        <span class="text-label text-ink-muted"><%= dim_label %></span>
        <span class="font-medium"><%= current_label %></span>
        <%= tag.svg viewBox: "0 0 20 20", fill: "none", stroke: "currentColor", "stroke-width": "1.6", "stroke-linecap": "round", "stroke-linejoin": "round", class: "h-4 w-4 text-ink-subtle" do %>
          <polyline points="6 8 10 12 14 8"></polyline>
        <% end %>
      </summary>
      <ul class="absolute right-0 z-10 mt-1 min-w-[10rem] rounded-control border border-border bg-surface py-1 shadow-dropdown">
        <% options.each do |key, label| %>
          <li>
            <%= link_to label,
                  "#{base}?#{request.query_parameters.merge(param.to_s => key).to_query}",
                  class: "block px-3 py-1.5 text-body #{key == current ? 'text-primary-600' : 'text-ink-body hover:bg-primary-50'}" %>
          </li>
        <% end %>
      </ul>
    </details>
  <% end %>
</div>
