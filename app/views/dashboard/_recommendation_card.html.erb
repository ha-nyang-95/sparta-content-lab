<%# §4.2 추천 카드 — 번호 뱃지·제목·스탯 라인·기회 점수·근거 보기(모달). 로컬: recommendation, rank, videos_by_rec. %>
<% mult = recommendation_multiple(recommendation, videos_by_rec) %>
<%# 실제 존재하는 참고 영상만 센다 — AD-10 스냅샷은 삭제 영상 id 가 댕글링될 수 있어 size 는 과대 계수. %>
<% present_video_ids = recommendation.reference_video_ids.select { |id| videos_by_rec[id] } %>
<% competitor_count = present_video_ids.size %>
<% has_own = recommendation_has_own_match?(recommendation, videos_by_rec) %>
<article class="flex flex-col gap-4 rounded-card border border-border bg-surface p-6 shadow-card transition hover:shadow-cardHover"
         data-controller="modal">
  <div class="flex items-start gap-3">
    <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-control bg-primary-600 font-bold text-white tabular-nums"><%= rank %></span>
    <h3 class="min-w-0 break-keep line-clamp-2 text-h3 text-ink-strong" title="<%= recommendation.topic_label %>">
      <%= recommendation.topic_label.presence || "제목 없음" %>
    </h3>
  </div>

  <div class="flex items-start justify-between gap-4">
    <ul class="flex min-w-0 flex-col gap-1.5 text-body text-ink-body">
      <li class="flex items-center gap-1.5">
        <span class="text-ink-subtle" aria-hidden="true">↗</span>
        <span>경쟁 영상 <span class="tabular-nums"><%= competitor_count %></span>개 상승</span>
      </li>
      <li class="flex items-center gap-1.5" title="<%= performance_bias_note %>">
        <span class="text-ink-subtle" aria-hidden="true">◉</span>
        <span><%= performance_multiple_label %> <span class="tabular-nums"><%= mult.nil? ? "—" : format("%.1f×", mult) %></span></span>
      </li>
      <li class="flex items-center gap-1.5">
        <span class="text-ink-subtle" aria-hidden="true">◎</span>
        <span>자사 유사 영상 <%= has_own ? "있음" : "없음" %></span>
      </li>
    </ul>
    <div class="shrink-0 text-right">
      <span class="block text-label text-ink-muted">기회 점수</span>
      <span class="text-score text-primary-600 tabular-nums"><%= recommendation.opportunity_score.nil? ? "—" : recommendation.opportunity_score.round %></span><span class="text-caption text-ink-muted">/100</span>
    </div>
  </div>

  <%# mt-auto — 제목 길이가 달라도 버튼을 카드 하단에 고정(카드끼리 높이 정렬). %>
  <button type="button"
          data-action="modal#open"
          aria-haspopup="dialog"
          class="mt-auto inline-flex items-center justify-center gap-1 rounded-control border border-border bg-transparent px-3.5 py-2 text-body text-primary-600 transition hover:bg-primary-50">
    근거 보기 <span aria-hidden="true">→</span>
  </button>

  <%# 근거 모달 — 백드롭 + 다이얼로그. 기본 hidden, modal#open 이 표시. %>
  <div data-modal-target="dialog" class="hidden">
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4">
      <div class="fixed inset-0 bg-ink-strong/50" data-action="click->modal#backdrop"></div>
      <div class="relative z-10 flex max-h-[80vh] w-full max-w-lg flex-col rounded-card bg-surface shadow-cardHover"
           role="dialog" aria-modal="true" aria-label="추천 근거 참고 영상" tabindex="-1" data-modal-focus>
        <div class="flex items-start justify-between gap-3 border-b border-border-subtle p-5">
          <div class="min-w-0">
            <h4 class="text-h3 text-ink-strong">근거 — 참고 영상</h4>
            <p class="mt-0.5 min-w-0 break-keep line-clamp-1 text-caption text-ink-muted" title="<%= recommendation.topic_label %>"><%= recommendation.topic_label %></p>
          </div>
          <button type="button" data-action="modal#close" aria-label="닫기"
                  class="shrink-0 rounded-control p-1 text-ink-muted hover:bg-surface-sunken hover:text-ink-strong">
            <%= tag.svg viewBox: "0 0 20 20", fill: "none", stroke: "currentColor", "stroke-width": "1.8", "stroke-linecap": "round", class: "h-5 w-5" do %>
              <line x1="5" y1="5" x2="15" y2="15"></line><line x1="15" y1="5" x2="5" y2="15"></line>
            <% end %>
          </button>
        </div>
        <div class="overflow-y-auto p-5">
          <% if competitor_count.zero? %>
            <p class="text-caption text-ink-muted">참고 영상이 없습니다.</p>
          <% else %>
            <ul class="flex flex-col gap-3">
              <% present_video_ids.each do |id| %>
                <% video = videos_by_rec[id] %>
                <li class="flex items-center gap-3">
                  <%# 근거 영상도 클릭 → 기획 분석 모달(같은 공유 모달). %>
                  <button type="button" data-action="video-analysis#open"
                          data-video-analysis-title-param="<%= video&.title %>"
                          data-video-analysis-youtube-param="<%= youtube_watch_url(video) %>"
                          data-video-analysis-analysis-param="<%= video_analysis_path(video) %>"
                          class="flex min-w-0 flex-1 items-center gap-3 text-left hover:text-primary-600">
                    <%= render "shared/video_thumb", video: video %>
                    <div class="min-w-0 flex-1">
                      <span class="block min-w-0 break-keep truncate text-body text-ink-strong" title="<%= video&.title %>"><%= video&.title.presence || "영상 #{id}" %></span>
                      <span class="block truncate text-caption text-ink-muted" title="<%= video&.channel&.name %>"><%= video&.channel&.name.presence || "미상" %></span>
                    </div>
                  </button>
                  <div class="shrink-0">
                    <%= render "shared/performance_cell",
                          multiple: video&.video_score&.performance_multiple,
                          view_count: video&.view_count,
                          needs_verification: video&.video_score&.needs_verification || false %>
                  </div>
                </li>
              <% end %>
            </ul>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</article>
