<%# 콘텐츠 갭 — §4.6 도넛+범례(콘텐츠 기회 분포) → 선택 구간 §4.3 영상 리스트(6.1 _video_row 재사용). 읽기 전용(AD-3). %>
<% content_for :title, "콘텐츠 갭" %>

<h2 class="text-h2 text-ink-strong">콘텐츠 갭</h2>
<p class="mt-1 text-caption text-ink-muted">경쟁 채널은 만들었지만 우리는 아직 안 만든 주제(콘텐츠 기회)입니다.</p>

<%# 도넛+범례 카드 — lg 가로, 모바일 스택(§5). %>
<div class="mt-6 rounded-card border border-border bg-surface p-6 shadow-card">
  <div class="flex flex-col items-center gap-8 lg:flex-row lg:items-center lg:gap-10">
    <%= render "donut" %>
    <div class="w-full lg:max-w-xs">
      <%= render "legend" %>
    </div>
  </div>
</div>

<%# 선택 구간 영상 리스트 — 6.1 _video_row(rank 없음·sparkline 없음 → 6컬럼). %>
<% total = @distribution.values.sum %>
<% if @scores.any? %>
  <h3 class="mt-8 text-h3 text-ink-strong"><%= content_gap_bucket_label(@bucket) %> 구간 영상</h3>
  <div class="mt-3 overflow-x-auto rounded-card border border-border bg-surface shadow-card">
    <table class="w-full min-w-[640px]">
      <thead>
        <tr class="border-b border-border-subtle bg-surface-sunken text-left text-label text-ink-muted">
          <th class="p-2 font-medium">영상</th>
          <th class="p-2 font-medium">채널</th>
          <th class="p-2 font-medium">업로드일</th>
          <th class="p-2 font-medium">조회수</th>
          <th class="p-2 font-medium">성과 배수</th>
          <th class="p-2 font-medium">자사 유사영상</th>
        </tr>
      </thead>
      <tbody>
        <% @scores.each do |score| %>
          <%= render "shared/video_row", video: score.video %>
        <% end %>
      </tbody>
    </table>
  </div>
<% elsif total > 0 %>
  <%# 구간을 선택했으나 해당 버킷 0건 — 도넛은 유지, 리스트만 빈 안내(운영자가 다른 세그먼트 선택). %>
  <div class="mt-8 rounded-card border border-border bg-surface p-6 shadow-card">
    <p class="text-body text-ink-body">이 구간에 해당하는 영상이 없습니다.</p>
  </div>
<% else %>
  <%# 콜드스타트 — 분류된 경쟁 스코어 0. 위젯 자리 유지(AD-16). %>
  <div class="mt-8 rounded-card border border-border bg-surface p-6 shadow-card">
    <p class="text-body text-ink-body">분류된 경쟁 영상이 아직 없습니다.</p>
    <div class="mt-3">
      <%= render "shared/honesty_status", status: :collecting, detail: "데이터 수집 중" %>
    </div>
  </div>
<% end %>
