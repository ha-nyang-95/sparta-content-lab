<%# 앱 셸 헤더 — 제목·부제·검색바 자리·오늘 업데이트·아바타 2인·+ 버튼 (Story 1.4, DESIGN.md §4.8). %>
<header class="flex items-center gap-4 border-b border-border bg-surface px-6 py-4">
  <%# 모바일 햄버거 — 좌측 드로어 토글(md 이상 숨김). %>
  <button type="button" data-action="click->sidebar#toggle"
          data-sidebar-target="toggle"
          aria-label="메뉴" aria-controls="app-sidebar" aria-expanded="false"
          class="shrink-0 rounded-control p-2 text-ink-muted hover:bg-primary-50 md:hidden">
    <%= tag.svg viewBox: "0 0 24 24", fill: "none", stroke: "currentColor",
          "stroke-width": "1.7", "stroke-linecap": "round", class: "h-6 w-6" do %>
      <line x1="4" y1="7" x2="20" y2="7"></line>
      <line x1="4" y1="12" x2="20" y2="12"></line>
      <line x1="4" y1="17" x2="20" y2="17"></line>
    <% end %>
  </button>

  <div class="min-w-0">
    <h1 class="break-keep text-h1 text-ink-strong">YouTube 콘텐츠 리서치</h1>
    <p class="break-keep text-caption text-ink-muted">다음 주 제작할 주제를 10분 안에 결정하세요</p>
  </div>

  <div class="ml-auto flex items-center gap-3">
    <%# 실시간 검색(타입어헤드) — 입력 시 아래로 상위 5건, 초과분은 '모두 보기'로 인기 페이지 전체 검색. 엔터도 전체 검색. %>
    <div class="relative hidden lg:block" data-controller="search"
         data-search-url-value="<%= search_path %>">
      <%= form_with url: popular_path, method: :get, role: "search", data: { turbo: false } do %>
        <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-ink-subtle">
          <%= tag.svg viewBox: "0 0 24 24", fill: "none", stroke: "currentColor",
                "stroke-width": "1.7", "stroke-linecap": "round", class: "h-4 w-4" do %>
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="16.5" y1="16.5" x2="21" y2="21"></line>
          <% end %>
        </span>
        <input type="text" name="q" autocomplete="off"
               placeholder="주제, 키워드, 채널 검색"
               data-search-target="input" data-action="input->search#query"
               class="w-64 rounded-control border border-border bg-surface py-2 pl-9 pr-3 text-body text-ink-body placeholder:text-ink-subtle">
      <% end %>

      <%# 결과 드롭다운 — 박스 크기 고정(리스트는 max-h 안에서 내부 스크롤, 더 커지지 않음). 초과분은 '모두 보기'로 펼쳐 스크롤. 기본 숨김. %>
      <div data-search-target="results"
           class="absolute left-0 right-0 z-50 mt-1 hidden overflow-hidden rounded-card border border-border bg-surface shadow-card">
        <div data-search-target="list" class="max-h-72 overflow-y-auto"></div>
        <button type="button" data-search-target="more" data-action="search#showAll"
                class="hidden block w-full border-t border-border-subtle px-3 py-2 text-left text-caption font-medium text-primary-600 hover:bg-primary-50">모두 보기</button>
      </div>
    </div>

    <%# 오늘 업데이트 — 수집 트리거 + 진행 게이지(3초 폴링). 유휴엔 버튼+마지막 수집, 진행 중엔 단계 게이지. %>
    <div class="hidden shrink-0 sm:block" data-controller="collection"
         data-collection-status-url-value="<%= collection_status_path %>">
      <%# 유휴 상태 — 트리거 버튼 + 마지막 수집 시각(§4.8 outline 버튼). %>
      <div data-collection-target="idle" class="flex items-center gap-2">
        <%= button_to collections_path, method: :post, form_class: "shrink-0",
              class: "inline-flex items-center gap-2 rounded-control border border-border bg-transparent px-3.5 py-2 text-body text-primary-600 hover:bg-primary-50",
              data: { "collection-target": "button" } do %>
          <%= tag.svg viewBox: "0 0 24 24", fill: "none", stroke: "currentColor",
                "stroke-width": "1.7", "stroke-linecap": "round", "stroke-linejoin": "round", class: "h-4 w-4" do %>
            <path d="M4 12a8 8 0 0 1 14-5l2 2"></path>
            <path d="M20 4v5h-5"></path>
            <path d="M20 12a8 8 0 0 1-14 5l-2-2"></path>
            <path d="M4 20v-5h5"></path>
          <% end %>
          오늘 업데이트
        <% end %>
        <span data-collection-target="lastRun" class="hidden whitespace-nowrap text-caption text-ink-muted"></span>
      </div>

      <%# 진행 중 상태 — '오늘 업데이트' 박스를 그대로 유지하고 그 안에서 게이지가 반투명하게 차오른다.
          단계 문구는 박스 중앙에, 진행률 수치는 우측에 흐리게. 레이아웃이 흔들리지 않게 버튼과 같은 형태·크기. %>
      <div data-collection-target="running" class="relative hidden w-44 overflow-hidden rounded-control border border-border bg-surface">
        <%# 반투명 진행 fill — 좌→우로 width 증가(primary 20% 불투명도). %>
        <div data-collection-target="bar" class="absolute inset-y-0 left-0 bg-primary-600/20 transition-all duration-500" style="width: 0%"></div>
        <%# 중앙: 현재 단계(진하게) · 우측: 진행률 수치(흐리게) — fill 위에 얹힌다. %>
        <div class="relative flex items-center justify-center px-3.5 py-2">
          <span data-collection-target="phase" class="text-body font-medium text-primary-700">수집 중</span>
          <span data-collection-target="percent" class="absolute right-3 text-caption tabular-nums text-primary-600/60">0%</span>
        </div>
      </div>
    </div>

    <%# + 채널 추가 — 경쟁 채널 등록 화면으로 이동(§4.8 원형 버튼 스타일 유지). %>
    <%= link_to competitors_path, aria: { label: "채널 추가" }, title: "채널 추가",
          class: "flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary-600 text-white hover:bg-primary-700" do %>
      <%= tag.svg viewBox: "0 0 24 24", fill: "none", stroke: "currentColor",
            "stroke-width": "2", "stroke-linecap": "round", class: "h-5 w-5" do %>
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <line x1="5" y1="12" x2="19" y2="12"></line>
      <% end %>
    <% end %>

    <%# 계정 메뉴 — 아바타 클릭 시 로그인 이메일 + 로그아웃(외부 클릭 시 자동 닫힘 dropdown). %>
    <details class="relative shrink-0" data-controller="dropdown">
      <summary class="flex cursor-pointer list-none items-center [&::-webkit-details-marker]:hidden"
               aria-label="계정 메뉴">
        <span class="flex h-9 w-9 items-center justify-center rounded-full bg-primary-100 text-label font-semibold text-primary-600">
          <%= Current.user&.email_address.to_s.first&.upcase.presence || "?" %>
        </span>
      </summary>
      <div class="absolute right-0 z-50 mt-2 w-60 rounded-card border border-border bg-surface p-2 shadow-card">
        <p class="truncate px-2 py-1.5 text-caption text-ink-muted" title="<%= Current.user&.email_address %>">
          <%= Current.user&.email_address %>
        </p>
        <div class="my-1 border-t border-border-subtle"></div>
        <%= button_to "로그아웃", session_path, method: :delete, form_class: "w-full",
              class: "w-full rounded-control px-2 py-1.5 text-left text-body text-ink-body hover:bg-primary-50" %>
      </div>
    </details>
  </div>
</header>
