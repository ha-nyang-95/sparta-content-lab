<%# 앱 셸 헤더 — 제목·부제·검색바 자리·오늘 업데이트·아바타 2인·+ 버튼 (Story 1.4, DESIGN.md §4.8). %>
<header class="flex items-center gap-4 border-b border-border bg-surface px-6 py-4">
  <%# 모바일 햄버거 — 좌측 드로어 토글(md 이상 숨김). %>
  <button type="button" data-action="click->sidebar#toggle"
          data-sidebar-target="toggle"
          aria-label="메뉴" aria-controls="app-sidebar" aria-expanded="false"
          class="shrink-0 rounded-control p-2 text-ink-muted hover:bg-primary-50 md:hidden">
    <%= tag.svg viewBox: "0 0 24 24", fill: "none", stroke: "currentColor",
          "stroke-width": "1.7", "stroke-linecap": "round", class: "h-6 w-6" do %>
      <line x1="4" y1="7" x2="20" y2="7"></line>
      <line x1="4" y1="12" x2="20" y2="12"></line>
      <line x1="4" y1="17" x2="20" y2="17"></line>
    <% end %>
  </button>

  <div class="min-w-0">
    <h1 class="break-keep text-h1 text-ink-strong">YouTube 콘텐츠 리서치</h1>
    <p class="break-keep text-caption text-ink-muted">다음 주 제작할 주제를 10분 안에 결정하세요</p>
  </div>

  <div class="ml-auto flex items-center gap-3">
    <%# 검색바 — 시각 자리만(비동작). readonly 로 입력 방지, 폼 래핑 없음. %>
    <div class="relative hidden lg:block">
      <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-ink-subtle">
        <%= tag.svg viewBox: "0 0 24 24", fill: "none", stroke: "currentColor",
              "stroke-width": "1.7", "stroke-linecap": "round", class: "h-4 w-4" do %>
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="16.5" y1="16.5" x2="21" y2="21"></line>
        <% end %>
      </span>
      <input type="text" readonly tabindex="-1"
             placeholder="주제, 키워드, 채널 검색"
             class="w-64 rounded-control border border-border bg-surface py-2 pl-9 pr-3 text-body text-ink-body placeholder:text-ink-subtle">
    </div>

    <%# 오늘 업데이트 — 수집 트리거 + 진행 게이지(3초 폴링). 유휴엔 버튼+마지막 수집, 진행 중엔 단계 게이지. %>
    <div class="hidden shrink-0 sm:block" data-controller="collection"
         data-collection-status-url-value="<%= collection_status_path %>">
      <%# 유휴 상태 — 트리거 버튼 + 마지막 수집 시각(§4.8 outline 버튼). %>
      <div data-collection-target="idle" class="flex items-center gap-2">
        <%= button_to collections_path, method: :post, form_class: "shrink-0",
              class: "inline-flex items-center gap-2 rounded-control border border-border bg-transparent px-3.5 py-2 text-body text-primary-600 hover:bg-primary-50",
              data: { "collection-target": "button" } do %>
          <%= tag.svg viewBox: "0 0 24 24", fill: "none", stroke: "currentColor",
                "stroke-width": "1.7", "stroke-linecap": "round", "stroke-linejoin": "round", class: "h-4 w-4" do %>
            <path d="M4 12a8 8 0 0 1 14-5l2 2"></path>
            <path d="M20 4v5h-5"></path>
            <path d="M20 12a8 8 0 0 1-14 5l-2-2"></path>
            <path d="M4 20v-5h5"></path>
          <% end %>
          오늘 업데이트
        <% end %>
        <span data-collection-target="lastRun" class="hidden whitespace-nowrap text-caption text-ink-muted"></span>
      </div>

      <%# 진행 중 상태 — 단계 라벨 + 가중 진행률 게이지 바. %>
      <div data-collection-target="running" class="hidden w-56">
        <div class="flex items-center justify-between text-caption text-ink-muted">
          <span data-collection-target="phase">수집 중…</span>
          <span data-collection-target="percent" class="tabular-nums">0%</span>
        </div>
        <div class="mt-1 h-2 w-full overflow-hidden rounded-full bg-border-subtle">
          <div data-collection-target="bar" class="h-full rounded-full bg-primary-600 transition-all duration-500" style="width: 0%"></div>
        </div>
      </div>
    </div>

    <%# 아바타 2인 — 실사진 없음, 원형 이니셜 플레이스홀더(§4.5). %>
    <div class="flex items-center -space-x-2">
      <span data-avatar
            class="flex h-9 w-9 items-center justify-center rounded-full border-2 border-surface bg-primary-100 text-label font-semibold text-primary-600">S</span>
      <span data-avatar
            class="flex h-9 w-9 items-center justify-center rounded-full border-2 border-surface bg-success-100 text-label font-semibold text-success-700">H</span>
    </div>

    <%# + 원형 버튼(§4.8): primary-600 배경·흰 +. %>
    <button type="button" aria-label="추가"
            class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary-600 text-white hover:bg-primary-700">
      <%= tag.svg viewBox: "0 0 24 24", fill: "none", stroke: "currentColor",
            "stroke-width": "2", "stroke-linecap": "round", class: "h-5 w-5" do %>
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <line x1="5" y1="12" x2="19" y2="12"></line>
      <% end %>
    </button>
  </div>
</header>
