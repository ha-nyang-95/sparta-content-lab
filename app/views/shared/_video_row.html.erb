<%# 급상승 영상 행 — 썸네일·제목·채널·업로드일·조회수·성과 배수·자사 유사영상·유형·구독자 밴드(§7 다국어 방어·nil 방어 AD-9). 로컬: video.
    소비 화면은 N+1 방지를 위해 반드시 `includes(:video_score, :channel)`로 프리로드한다(행마다 video_score·channel 접근). %>
<% score = video.video_score %>
<tr class="border-b border-border-subtle">
  <td class="p-2">
    <% if video.thumbnail.present? %>
      <img src="<%= video.thumbnail %>" alt="<%= video.title.presence || "제목 없음" %>" width="96" height="54" class="h-[54px] w-24 rounded-control object-cover" loading="lazy">
    <% else %>
      <div class="h-[54px] w-24 rounded-control bg-surface-sunken" aria-hidden="true"></div>
    <% end %>
  </td>
  <td class="p-2">
    <div class="min-w-0">
      <%# lang 하드코딩 안 함 — 한·일 혼재라 단일 lang 은 절반을 오표시(스크린리더 오독). §7 방어는 폰트 폴백·break-keep·line-clamp·min-w-0·title 툴팁으로 충족. per-title 언어 감지는 향후. %>
      <% if video.title.present? %>
        <span class="font-sans break-keep line-clamp-2 text-ink-strong" title="<%= video.title %>"><%= video.title %></span>
      <% else %>
        <span class="text-ink-muted">제목 없음</span>
      <% end %>
    </div>
  </td>
  <td class="p-2">
    <span class="block min-w-0 max-w-[12rem] truncate text-ink-body" title="<%= video.channel&.name %>"><%= video.channel&.name.presence || "미상" %></span>
  </td>
  <td class="p-2 tabular-nums text-ink-body">
    <% if video.published_at %>
      <%= video.published_at.to_date.strftime("%Y.%m.%d") %>
    <% else %>
      <span class="text-ink-muted">미상</span>
    <% end %>
  </td>
  <td class="p-2 tabular-nums text-ink-body"><%= video.view_count.nil? ? "—" : number_with_delimiter(video.view_count) %></td>
  <td class="p-2">
    <%= render "shared/performance_cell",
               multiple: score&.performance_multiple,
               view_count: video.view_count,
               needs_verification: score&.needs_verification || false %>
  </td>
  <td class="p-2 tabular-nums text-ink-body">
    <% match = score&.own_match_count %>
    <%= match.nil? || match.zero? ? "없음" : "#{match}개" %>
  </td>
  <td class="p-2">
    <% type = video_type_label(video) %>
    <% if type %>
      <span class="inline-flex items-center rounded-chip bg-badge-neutralBg px-1.5 py-0.5 text-label text-badge-neutralFg"><%= type %></span>
    <% end %>
  </td>
  <td class="p-2">
    <% band = subscriber_band_label(video.channel) %>
    <% if band %>
      <span class="inline-flex items-center rounded-chip bg-badge-neutralBg px-1.5 py-0.5 text-label text-badge-neutralFg"><%= band %></span>
    <% else %>
      <span class="text-ink-muted">미상</span>
    <% end %>
  </td>
</tr>
