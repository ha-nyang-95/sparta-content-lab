<%# 인기 콘텐츠 — §4.3 급상승 테이블(순번/영상/채널/업로드일/조회수/성과 배수/트렌드/자사 유사영상) + 6.2 필터 재사용. 읽기 전용(AD-3), 밴드 그룹/평면 토글. %>
<% content_for :title, "인기 콘텐츠" %>

<h2 class="text-h2 text-ink-strong">인기 콘텐츠</h2>
<p class="mt-1 text-caption text-ink-muted">성과 배수 상위 급상승 영상입니다.</p>

<%# 검색바 + 규모 필터. 정렬은 표 칼럼 헤더로, 채널·배수 필터는 제거(운영자 요청). %>
<%= render "popular/search_bar", q: @q, band: @band,
      period: @period, category: @category, type: @type %>

<%# 필터 행 — 기간 탭(좌) + 카테고리/유형(우). base_path 로 popular 재사용. %>
<div class="mt-4 flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
  <%= render "dashboard/period_tabs", current: @period, base_path: popular_path %>
  <%# 규모·카테고리·유형 한 줄. %>
  <%= render "dashboard/filter_bar", category: @category, type: @type, band: @band, base_path: popular_path %>
</div>

<% if @scores.any? %>
  <%# 테이블 영역만 가로 스크롤(§5), 본문은 min-w 로 컬럼 유지. %>
  <div class="mt-6 overflow-x-auto rounded-card border border-border bg-surface shadow-card">
    <table class="w-full min-w-[720px]">
      <thead>
        <tr class="border-b border-border-subtle bg-surface-sunken text-left text-label text-ink-muted">
          <th class="p-2 font-medium">영상</th>
          <th class="p-2 font-medium">채널</th>
          <%= sortable_th "업로드일", "uploaded", popular_path %>
          <%= sortable_th "조회수", "views", popular_path %>
          <%= sortable_th "성과 배수", "multiple", popular_path %>
          <th class="p-2 font-medium">트렌드</th>
          <th class="p-2 font-medium">자사 유사영상</th>
          <th class="p-2 font-medium">저장</th>
        </tr>
      </thead>
      <tbody>
        <%# 평면 리스트 — 정렬은 칼럼 헤더로. 기본 성과 배수 desc. %>
        <% @scores.each do |score| %>
          <%= render "shared/video_row", video: score.video, sparkline: true, evergreen: (@period == "evergreen"), saved_ids: @saved_ids %>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <%# empty 상태 — 정직성: 데이터가 있는데 필터가 0건이면 "조건 없음", 스코어 자체가 없으면 콜드스타트(AD-16·§4.7). %>
  <div class="mt-6 rounded-card border border-border bg-surface p-6 shadow-card">
    <% if @has_any_scores %>
      <p class="text-body text-ink-body">검색·필터 조건에 맞는 급상승 영상이 없습니다.</p>
      <p class="mt-1 text-caption text-ink-muted">검색어나 필터를 바꿔 보세요.</p>
    <% else %>
      <p class="text-body text-ink-body">급상승 영상이 아직 없습니다.</p>
      <div class="mt-3">
        <%= render "shared/honesty_status", status: :collecting, detail: "데이터 수집 중" %>
      </div>
    <% end %>
  </div>
<% end %>

<%# NOTE: loading(스켈레톤) — 콜드스타트 시 각 행 트렌드 셀이 §4.7 "데이터 수집 중" 자리로 흡수(전역 배너 없음). error 는 컨트롤러가 던지면 Rails 기본 에러 페이지가 처리. %>
